GROQ_API_KEY=your_groq_api_key_here

# Available models on Groq:
# openai/gpt-oss-120b  -> higher quality & fresh rate limit
# openai/gpt-oss-20b   -> fast
# qwen/qwen3.6-27b     -> open weight reasoning
LLM_MODEL=openai/gpt-oss-120b

# Admin password to unlock the Shop / My Store page
ADMIN_PIN=1234

# Telegram Bot Integration for OTP & Notifications
TELEGRAM_BOT_TOKEN=your_telegram_bot_token_here
TELEGRAM_CHAT_ID=your_telegram_chat_id_here